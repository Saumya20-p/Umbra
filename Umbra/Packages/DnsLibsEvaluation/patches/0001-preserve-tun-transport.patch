+
+TEST(TunListenerTest, ProtocolCallbackInvalidParameters) {
+    TunListener listener;
+    TunListener::RequestCallbackWithProtocol callback
+            = [](ag::Uint8View, ag::utils::TransportProtocol, TunListener::Completion) {};
+
+    auto result = listener.init(-1, -1, callback);
+    ASSERT_TRUE(result);
+    EXPECT_EQ(result->value(), TunListener::IE_INVALID_MTU);
+
+    TunListener::RequestCallbackWithProtocol null_callback;
+    result = listener.init(-1, 1500, null_callback);
+    ASSERT_TRUE(result);
+    EXPECT_EQ(result->value(), TunListener::IE_INVALID_CALLBACK);
+
+    result = listener.init(-1, 1500, callback);
+    ASSERT_TRUE(result);
+    EXPECT_EQ(result->value(), TunListener::IE_INVALID_CALLBACK);
+    listener.deinit();
+}
+
+TEST(TunListenerTest, LegacyNullLiteralRemainsUnambiguous) {
+    TunListener listener;
+    auto result = listener.init(-1, 1500, nullptr);
+    ASSERT_TRUE(result);
+    EXPECT_EQ(result->value(), TunListener::IE_INVALID_CALLBACK);
+
+    result = listener.init(-1, 1500, nullptr, [](ag::Uint8View) {});
+    ASSERT_TRUE(result);
+    EXPECT_EQ(result->value(), TunListener::IE_INVALID_CALLBACK);
+
+    result = listener.init(-1, -1, nullptr);
+    ASSERT_TRUE(result);
+    EXPECT_EQ(result->value(), TunListener::IE_INVALID_MTU);
+}
